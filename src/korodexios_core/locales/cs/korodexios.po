msgstr "{job_id} se spustila; Ctrl+C zastaví sledování, ne úlohu"

#: cli/language.py
msgid "{locale}: {added} new, {stale} obsolete"
msgstr "{locale}: {added} nových, {stale} zastaralých"

#: cli/users.py
msgid "{name} is now {role}"
msgstr "{name} má nyní roli {role}"

#: cli/service.py
msgid "{name} removed; the daemon no longer starts at logon"
msgstr "{name} byla odstraněna; démon se už nespouští při přihlášení"

#: cli/service.py
msgid "{name} was not registered; nothing to remove"
msgstr "{name} nebyla registrována; není co odstranit"

#: cli/commands.py
msgid "{name}: {count} keys, required={required} secrets={secrets}"
msgstr "{name}: {count} klíčů, povinné={required} tajné={secrets}"

#: cli/language.py
msgid "{origin} still wins over kdx.local.yml; the new value applies once it is removed"
msgstr "{origin} má stále přednost před kdx.local.yml; nová hodnota platí, až ho odstraníš"

#: cli/language.py
msgid "{path} already exists"
msgstr "{path} už existuje"

#: cli/language.py
msgid "{path} cannot be read as JSON: {reason}"
msgstr "{path} nelze přečíst jako JSON: {reason}"

#: cli/language.py
msgid "{path} cannot be read, so it was left alone: {reason}"
msgstr "{path} nelze přečíst, proto jsem ho nechal beze změny: {reason}"

#: cli/language.py
msgid "{path} could not be written: {reason}"
msgstr "{path} se nepodařilo zapsat: {reason}"

#: cli/language.py
msgid "{path} created"
msgstr "{path} byl vytvořen"

#: cli/language.py
msgid "{path} does not exist; run kdx locale extract"
msgstr "{path} neexistuje; spusť kdx locale extract"

#: cli/language.py
msgid "{path} is not a directory"
msgstr "{path} není adresář"

#: cli/language.py
msgid "{path} is out of date; run kdx locale extract"
msgstr "{path} je zastaralý; spusť kdx locale extract"

#: cli/language.py
msgid "{path} is up to date"
msgstr "{path} je aktuální"

#: cli/language.py
msgid "{path} must hold a JSON object"
msgstr "{path} musí obsahovat objekt JSON"

#: cli/commands.py
msgid "{path}: declared but not found"
msgstr "{path}: deklarováno, ale nenalezeno"

#: cli/commands.py
msgid "{path}: declared {declared}..., read {actual}..."
msgstr "{path}: deklarováno {declared}..., načteno {actual}..."

#: cli/service.py
msgid "{program} could not run: {exc}"
msgstr "{program} se nepodařilo spustit: {exc}"

#: cli/service.py
msgid "{shown} failed: {value}"
msgstr "{shown} selhalo: {value}"

#: cli/language.py
msgid "{value} is not a language code; use a form such as sk or sk_SK, or 'auto'"
msgstr "{value} není kód jazyka; použij tvar jako sk nebo sk_SK, případně 'auto'"

#: cli/language.py
msgid "{value} is not a language to translate into"
msgstr "{value} není jazyk, do kterého lze překládat"

#: cli/users.py
msgid "{verb}; this token is shown only now - hand it over privately"
msgstr "{verb}; tento token se zobrazí pouze teď - předej ho soukromě"
